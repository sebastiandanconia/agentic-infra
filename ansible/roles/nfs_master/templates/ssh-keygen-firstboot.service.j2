{# roles/nfs_master/templates/ssh-keygen-firstboot.service.j2 #}
# /etc/systemd/system/ssh-keygen-firstboot.service
# Generated by Ansible (roles/nfs_master).
#
# Generates unique SSH host keys on first boot, only when no ed25519 host
# key exists. Ordering: Before=ssh.service ensures keys exist before ssh
# starts. ssh.service is enabled separately, so on subsequent boots (keys
# already present) the condition fails and ssh starts normally.

[Unit]
Description=Generate SSH host keys on first boot
ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key
Before=ssh.service

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -A
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
