{# roles/nfs_master/templates/nfs-shutdown-fix.service.j2 #}
# /etc/systemd/system/nfs-shutdown-fix.service
# Generated by Ansible (roles/nfs_master).
#
# Remounts the NFS root read-only and syncs before shutdown so the host
# powers off cleanly instead of hanging on a busy NFS mount.

[Unit]
Description=Remount NFS root read-only before shutdown
DefaultDependencies=no
Before=shutdown.target umount.target
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/bin/sh -c 'mount -o remount,ro / && sync'

[Install]
WantedBy=multi-user.target
