  "homepage": "https://github.com/sebastiandanconia/agentic-infra",
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastiandanconia/agentic-infra.git"
  },
  "bugs": {
    "url": "https://github.com/sebastiandanconia/agentic-infra/issues"
  },
  "pi": {
